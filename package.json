{
  "name": "node-msk-notifier",
  "version": "1.0.0",
  "description": "Fastify notification service on EKS using MSK (Kafka) and SNS",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start:api": "node src/api/index.js",
    "start:consumer": "node src/consumer/index.js",
    "dev:api": "node --env-file=.env src/api/index.js",
    "dev:consumer": "node --env-file=.env src/consumer/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.600.0",
    "@fastify/sensible": "^5.6.0",
    "aws-msk-iam-sasl-signer-js": "^1.0.0",
    "fastify": "^4.28.0",
    "kafkajs": "^2.2.4",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.0.0"
  }
}
