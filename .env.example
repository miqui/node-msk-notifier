# ── Kafka / MSK ───────────────────────────────────────────────────────────────
# Comma-separated IAM broker endpoints from terraform output: msk_bootstrap_brokers_iam
MSK_BROKERS=b-1.node-msk-notifier.xxxxx.c2.kafka.us-east-1.amazonaws.com:9098,b-2.node-msk-notifier.xxxxx.c2.kafka.us-east-1.amazonaws.com:9098

# Kafka topic name (must match terraform variable kafka_topic_name)
KAFKA_TOPIC=notifications

# Consumer group ID
KAFKA_GROUP_ID=node-msk-notifier-consumer

# ── AWS / SNS ─────────────────────────────────────────────────────────────────
# AWS region
AWS_REGION=us-east-1

# Default SNS topic ARN for publishing notifications
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:notifications

# ── API ───────────────────────────────────────────────────────────────────────
# Shared secret for X-API-Key header authentication
API_KEY=change-me-in-production

# HTTP port for the API server
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
