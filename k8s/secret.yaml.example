# DO NOT commit real values. Create this secret manually or via CI/CD:
#
#   kubectl create secret generic node-msk-notifier-secrets \
#     --namespace=notifications \
#     --from-literal=MSK_BROKERS="broker1:9098,broker2:9098" \
#     --from-literal=SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:notifications" \
#     --from-literal=API_KEY="your-secret-api-key"
#
apiVersion: v1
kind: Secret
metadata:
  name: node-msk-notifier-secrets
  namespace: notifications
type: Opaque
stringData:
  MSK_BROKERS: "PLACEHOLDER"
  SNS_TOPIC_ARN: "PLACEHOLDER"
  API_KEY: "PLACEHOLDER"
